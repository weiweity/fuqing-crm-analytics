  "data_read": {
    "request": {
      "op": "data.read",
      "result_ref": "result_fixture_1",
      "mode": "summary",
      "cursor": null,
      "limit": 50
    },
    "response_summary_fields": ["unit", "time_range", "queried_at", "source", "row_count"],
    "budget": {"max_response_bytes": 65536, "max_cumulative_rows": 2000}
  },
  "errors": {
    "VERSION_CONFLICT": 409,
    "NOT_FOUND": 404,
    "FORBIDDEN": 403,
    "PREVIEW_EXPIRED": 409,
    "PREVIEW_CANCELLED": 409,
    "IDEMPOTENCY_CONFLICT": 409,
