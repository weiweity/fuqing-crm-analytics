    "package": {
      "html": "<!doctype html><html><body><h1 data-shine-node=\"n_title\">示例标题</h1><canvas data-shine-region=\"r_chart\"></canvas></body></html>",
      "css": "h1{font:600 28px/1.3 sans-serif}",
      "js": "document.querySelector('canvas')?.getContext('2d')",
      "resources": [],
      "node_map": [
