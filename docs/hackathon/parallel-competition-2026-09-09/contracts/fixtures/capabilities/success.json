      "pending_confirmation": true,
      "value": "EXCLUDE_CURRENT_SALES_ONLY"
    },
    {
      "key": "board_layout_mode",
      "note": "待确认。推荐一组认可分析一板多块；BATCH_MULTI_BOARD 为可选显式模式。",
      "pending_confirmation": true,
      "value": "ONE_BOARD_MULTI_BLOCK"
