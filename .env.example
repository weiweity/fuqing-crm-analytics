# Sample CRM - 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================================
# 数据源路径（Mac 开发环境示例）
# ============================================================
SHOP_DATA_SOURCE=/Users/yourname/Desktop/fuqin date/sample-crm-data
MEMBER_DATA_SOURCE=/Users/yourname/Desktop/fuqin date/sample-crm-data

# ============================================================
# ETL 配置
# ============================================================
SPU_MAPPING_SOURCE=config/spu_mapping.xlsx
CHANNEL_RULES_SOURCE=config/channel_rules.xlsx
TAOKE_DATA_SOURCE=/path/to/taoke/data
TAOKE_PRODUCT_SOURCE=/path/to/taoke/product
LIVE_DATA_SOURCE=/path/to/live/data

# ============================================================
# 数据库
# ============================================================
DUCKDB_PATH=data/processed/fuqing_crm.duckdb
PROCESSED_DATA_DIR=data/processed
PARQUET_DATA_DIR=data/parquet

# ============================================================
# Lark 通知（W6: ETL 跑完 lark-cli 推老板 + 运营）
# ============================================================
# 复用 scraper/core/sanity_check.py::_send_lark_alert 通道（lark-cli 私聊）
# NOTIFY_OPEN_IDS: 逗号分隔收件人 open_id 列表（ETL 跑完推给老板 + 运营）
#                  未配置/空 = 跳过通知（不报错，graceful degrade）
# LARK_BIN: lark-cli 路径（默认 /usr/local/bin/lark-cli）
# LARK_OPEN_ID: _send_lark_alert 单收件人 fallback（W6 走 NOTIFY_OPEN_IDS 不读它；
#              scraper 6 道门禁告警单收件人走这个）
NOTIFY_OPEN_IDS=ou_boss123,ou_op456
LARK_BIN=/usr/local/bin/lark-cli
LARK_OPEN_ID=ou_boss123

# ============================================================
# 管理员白名单（Sprint 205+ v3 admin upload 后台）
# ============================================================
# FQ_CRM_ADMINS: 逗号分隔用户名列表, 拥有管理员端点访问权限；未配置时无人是 admin
#                跟部署机上的 FQ_CRM_PASSWORDS 1:1 stable 配套
#                (跟 L4.86 + L4.88 conftest autouse fixture 治本模式 1:1 stable)
#                接手人 admin 后台运维: 改 env 重启 uvicorn 即可增删
FQ_CRM_ADMINS=admin
# ClickHouse 周监控必须显式使用独立账号，避免复用并踢出人工 admin 会话。
# 创建 monitor 凭据并把 FQ_CRM_ADMINS 改为 admin,monitor 后再取消下一行注释。
# monitor 还必须存在于部署机的 FQ_CRM_PASSWORDS；真实密码不得提交到仓库。
# FQ_POC_MONITOR_ADMIN_USERNAME=monitor
# 确认该账号不供任何人登录后，把同一用户名写入确认变量：
# FQ_POC_MONITOR_DEDICATED_ACCOUNT=monitor
# 仅当 FQ_CRM_PASSWORDS 保存 bcrypt hash 时，才由安全部署环境另行注入：
# FQ_POC_MONITOR_ADMIN_PASSWORD=<strong-random-password>

# ============================================================
# API 安全
# ============================================================
HEALTH_API_KEY=your-secret-key-here

# ============================================================
# 前端
# ============================================================
VITE_API_BASE_URL=http://localhost:8001

# Comma-separated Host header allowlist (TrustedHost). Default: localhost,127.0.0.1,testserver,[::1]
# ALLOWED_HOSTS=localhost,127.0.0.1,testserver,[::1]

# 仅信任这些反向代理地址/CIDR 的 X-Forwarded-*。
# 本地 Vite 默认只需 loopback；Compose 会在 docker-compose.yml 显式加入 Docker 私网 CIDR。
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ============================================================
# 黑客松 Mission 公网演示（默认关闭，仅允许合成数据）
# ============================================================
# 开启前先运行 scripts/synthetic/generate_hackathon_dataset.py。
# Mission 不会回退到 DUCKDB_PATH；下面三项未显式配置时失败关闭。
FQ_MISSION_DEMO_ENABLED=0
# 仅限受控本地演示：启用管理员“一键重置”；公网保持 0。
FQ_MISSION_DEMO_RESET_ENABLED=0
FQ_SYNTHETIC_DB_PATH=data/synthetic/syn-commerce-1.0.0.duckdb
FQ_MISSION_CONTROL_DB=data/control/hackathon-missions.sqlite3
FQ_MISSION_EXPORT_DIR=data/exports/hackathon
# 公网账号通过 FQ_CRM_PASSWORDS 在部署环境注入；不要把密码提交到仓库。
