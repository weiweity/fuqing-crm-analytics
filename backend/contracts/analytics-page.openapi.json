                  "$ref": "#/components/schemas/PagePreview"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/page-documents/previews/{preview_id}": {
      "get": {
        "operationId": "page_preview",
        "parameters": [
          {
            "name": "preview_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
