          },
          "permission_scope": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Permission Scope",
            "type": "string"
          },
          "product_ids": {
            "const": [],
            "default": [],
            "description": "This subset rejects any product filter; only the empty array is valid.",
            "items": false,
            "maxItems": 0,
            "minItems": 0,
            "prefixItems": [],
            "title": "Product Ids",
            "type": "array"
          },
          "query_id": {
            "const": "channel_first_observed_followup",
            "default": "channel_first_observed_followup",
            "title": "Query Id",
            "type": "string"
          },
          "query_version": {
            "const": "channel-followup-query/v1",
            "default": "channel-followup-query/v1",
            "title": "Query Version",
            "type": "string"
          },
          "resolved_cohort_end": {
            "format": "date-time",
            "title": "Resolved Cohort End",
            "type": "string"
          },
          "resolved_cohort_start": {
            "format": "date-time",
            "title": "Resolved Cohort Start",
            "type": "string"
          },
          "schema_version": {
            "const": "analytics-channel-followup/v1",
            "default": "analytics-channel-followup/v1",
            "title": "Schema Version",
            "type": "string"
          },
          "timezone": {
            "const": "Asia/Shanghai",
            "default": "Asia/Shanghai",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "resolved_cohort_start",
          "resolved_cohort_end",
          "observation_days",
          "as_of",
          "channel_ids",
          "permission_scope",
          "data_digest",
          "filter_hash"
        ],
        "title": "ChannelFollowupResolvedFilters",
        "type": "object"
      }
    },
