#!/usr/bin/env bash
# Active commit-msg gate: propagate the checker status.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "$#" -lt 1 ]; then
    echo "Usage: commit-msg <commit_msg_file>" >&2
    exit 2
fi

python3 "$PROJECT_ROOT/scripts/commit_msg_check.py" "$1"
EXIT_CODE=$?

if [ "$EXIT_CODE" -eq 1 ]; then
    echo ""
    echo "❌ commit-msg drift 检测失败, commit 被阻止 (Sprint 58 #2)"
    echo ""
    echo "修复方法:"
    echo "1. 把 commit msg 写得更具体"
    echo "2. 如检查有误，先定位并修复检查器；例外处理遵循 AGENTS.md，不默认绕过 hooks"
    echo ""
    exit 1
fi

exit "$EXIT_CODE"
