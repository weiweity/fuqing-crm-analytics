<?xml version="1.0" encoding="UTF-16"?>
<!--
PR3: Windows Task Scheduler XML for 芙清 ETL daily run (安全版)

硬约束:
- 禁止 SYSTEM + 用户可写仓库
- 使用专用低权账号 (LeastPrivilege)
- Command 必须是绝对 .venv\Scripts\python.exe 路径 (由 install_windows.ps1 替换)
- WorkingDirectory 为项目根绝对路径

安装:
  见 install_windows.ps1 (需 FQ_ETL_SERVICE_USER / FQ_ETL_SERVICE_PASSWORD / FQ_PROJECT_ROOT)

卸载:
  Unregister-ScheduledTask -TaskName "FuqingETLDaily" -TaskPath "\Fuqing\" -Confirm:$false
-->
<Task xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>芙清 CRM ETL 每日 8:30 增量跑批 (PR3 低权专用账号)</Description>
    <Author>fuqing-crm-analytics</Author>
    <URI>\Fuqing\ETLDaily</URI>
  </RegistrationInfo>

  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-06-01T08:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>

  <Principals>
    <Principal id="Author">
      <!-- install_windows.ps1 会替换为 FQ_ETL_SERVICE_USER; 模板占位禁止 SYSTEM -->
      <UserId>REPLACE_WITH_FQ_ETL_SERVICE_USER</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>

  <Actions>
    <Exec>
      <!-- install_windows.ps1 替换为绝对 .venv\Scripts\python.exe -->
      <Command>C:\Users\hutou\Desktop\fuqin date\fuqing-crm-analytics\.venv\Scripts\python.exe</Command>
      <Arguments>scripts\run_etl.py --update</Arguments>
      <WorkingDirectory>C:\Users\hutou\Desktop\fuqin date\fuqing-crm-analytics</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
